{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/proposal.schema.json",
  "title": "Atomic BOM Modification Proposal",
  "description": "One modification per proposal. Later this will be used by the LLM agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "part_id",
    "change_type",
    "target_field",
    "new_value"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "part_id": {
      "type": "string",
      "minLength": 1
    },
    "change_type": {
      "type": "string",
      "enum": [
        "material",
        "process",
        "raw_stock",
        "geometry",
        "fastener"
      ]
    },
    "target_field": {
      "type": "string",
      "minLength": 1
    },
    "old_value": {},
    "new_value": {},
    "reasoning_summary": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "material"
          }
        },
        "required": [
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "target_field": {
            "const": "material_id"
          },
          "new_value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "process"
          }
        },
        "required": [
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "target_field": {
            "const": "process_id"
          },
          "new_value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "change_type": {
            "const": "fastener"
          }
        },
        "required": [
          "change_type"
        ]
      },
      "then": {
        "properties": {
          "target_field": {
            "const": "fasteners"
          }
        }
      }
    }
  ]
}
